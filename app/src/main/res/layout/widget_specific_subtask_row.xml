<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_specific_subtask_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_item_card_bg"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="4dp">

    <ImageView
        android:id="@+id/widget_specific_subtask_check"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_widget_checkbox_unchecked"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/widget_specific_subtask_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Subtask item"
        android:textColor="#E2E8F0"
        android:textSize="12sp" />
</LinearLayout>
